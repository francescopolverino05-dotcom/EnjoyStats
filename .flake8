[flake8]
max-line-length = 100
extend-ignore = E203, E402, W503
exclude =
    .git,
    .venv,
    venv,
    __pycache__,
    build,
    dist,
    .eggs
per-file-ignores =
    data_models/__init__.py:F401
    analytics/__init__.py:F401
    api/__init__.py:F401
    config/__init__.py:F401
    storage/__init__.py:F401
    app/__init__.py:F401
