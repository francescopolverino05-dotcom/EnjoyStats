# syntax=docker/dockerfile:1
# FastAPI service — builder installs wheels, runtime keeps a slim interpreter.

FROM python:3.11-slim AS builder

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /src

RUN apt-get update \
    && apt-get install -y --no-install-recommends build-essential \
    && rm -rf /var/lib/apt/lists/*

COPY pyproject.toml README.md ./
COPY config ./config
COPY data_models ./data_models
COPY analytics ./analytics
COPY storage ./storage
COPY api ./api
COPY app ./app

RUN python -m venv /opt/venv \
    && /opt/venv/bin/pip install --upgrade pip \
    && /opt/venv/bin/pip install \
        "pydantic>=2.7,<3" \
        "pydantic-settings>=2.3,<3" \
        "fastapi>=0.111,<1" \
        "uvicorn[standard]>=0.30,<1" \
        "sqlalchemy[asyncio]>=2.0.30,<3" \
        "asyncpg>=0.29,<1" \
        "numpy>=1.26,<3" \
    && /opt/venv/bin/pip install --no-deps .

FROM python:3.11-slim AS runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PATH="/opt/venv/bin:$PATH" \
    PYTHONPATH=/app

WORKDIR /app

RUN useradd --system --uid 10001 --create-home --home-dir /home/enjoystats enjoystats

COPY --from=builder /opt/venv /opt/venv
COPY --from=builder --chown=enjoystats:enjoystats /src/config /app/config
COPY --from=builder --chown=enjoystats:enjoystats /src/data_models /app/data_models
COPY --from=builder --chown=enjoystats:enjoystats /src/analytics /app/analytics
COPY --from=builder --chown=enjoystats:enjoystats /src/storage /app/storage
COPY --from=builder --chown=enjoystats:enjoystats /src/api /app/api

USER enjoystats
EXPOSE 8000

HEALTHCHECK --interval=10s --timeout=5s --start-period=20s --retries=8 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/health', timeout=3)"

CMD ["python", "-m", "api.main"]
