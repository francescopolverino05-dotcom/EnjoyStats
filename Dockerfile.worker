# syntax=docker/dockerfile:1
# StatMan Analyse worker — claims queued jobs and runs full-match CV.
# Deploy as a Railway Worker service (no public HTTP port).

FROM python:3.11-slim AS builder

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /src

RUN apt-get update \
    && apt-get install -y --no-install-recommends build-essential \
    && rm -rf /var/lib/apt/lists/*

COPY pyproject.toml README.md requirements.txt ./
COPY config ./config
COPY data_models ./data_models
COPY analytics ./analytics
COPY app ./app

RUN python -m venv /opt/venv \
    && /opt/venv/bin/pip install --upgrade pip \
    && /opt/venv/bin/pip install -r requirements.txt

FROM python:3.11-slim AS runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    MPLBACKEND=Agg \
    PATH="/opt/venv/bin:$PATH" \
    PYTHONPATH=/app \
    ENJOYSTATS_JOBS_DIR=/data/jobs \
    ENJOYSTATS_FILM_INBOX=/data/inbox \
    ENJOYSTATS_FILM_UPLOADS=/data/uploads \
    STATMAN_WORKER_POLL_S=3

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        fonts-dejavu-core \
        libglib2.0-0 \
        libgl1 \
        tesseract-ocr \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --system --uid 10001 --create-home --home-dir /home/statman statman \
    && mkdir -p /data/jobs /data/inbox /data/uploads \
    && chown -R statman:statman /data

COPY --from=builder /opt/venv /opt/venv
COPY --from=builder --chown=statman:statman /src/config /app/config
COPY --from=builder --chown=statman:statman /src/data_models /app/data_models
COPY --from=builder --chown=statman:statman /src/analytics /app/analytics
COPY --from=builder --chown=statman:statman /src/app /app/app

USER statman
VOLUME ["/data"]

CMD ["python", "-m", "analytics.collect_worker"]
