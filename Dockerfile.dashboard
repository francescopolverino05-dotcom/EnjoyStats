# syntax=docker/dockerfile:1
# StatMan Web: portal + Streamlit + embedded Analyse worker (same /data disk).

FROM python:3.11-slim AS builder

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /src

RUN apt-get update \
    && apt-get install -y --no-install-recommends build-essential \
    && rm -rf /var/lib/apt/lists/*

COPY pyproject.toml README.md requirements.txt ./
COPY config ./config
COPY data_models ./data_models
COPY analytics ./analytics
COPY app ./app
COPY api ./api

RUN python -m venv /opt/venv \
    && /opt/venv/bin/pip install --upgrade pip \
    && /opt/venv/bin/pip install -r requirements.txt \
    && /opt/venv/bin/pip install "websockets>=12,<16"

FROM python:3.11-slim AS runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    MPLBACKEND=Agg \
    PATH="/opt/venv/bin:$PATH" \
    PYTHONPATH=/app \
    ENJOYSTATS_API_URL=http://127.0.0.1:18000 \
    ENJOYSTATS_JOBS_DIR=/data/jobs \
    ENJOYSTATS_FILM_INBOX=/data/inbox \
    ENJOYSTATS_FILM_UPLOADS=/data/uploads \
    ENJOYSTATS_SAME_ORIGIN_UPLOAD=1 \
    STATMAN_USE_EXTERNAL_WORKER=1 \
    STATMAN_EMBED_WORKER=1 \
    STATMAN_UPLOAD_ONLY=1 \
    STATMAN_STREAMLIT_FILM_UPLOAD=0 \
    ENJOYSTATS_UVICORN_APP=api.upload_app:app \
    ENJOYSTATS_PORT=18000 \
    ENJOYSTATS_UI_PORT=18501 \
    STATMAN_WORKER_POLL_S=3

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        fonts-dejavu-core \
        libglib2.0-0 \
        libgl1 \
        tesseract-ocr \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --system --uid 10001 --create-home --home-dir /home/enjoystats enjoystats \
    && mkdir -p /data/jobs /data/inbox /data/uploads /app/.local-run \
    && chown -R enjoystats:enjoystats /data /app

COPY --from=builder /opt/venv /opt/venv
COPY --from=builder --chown=enjoystats:enjoystats /src/config /app/config
COPY --from=builder --chown=enjoystats:enjoystats /src/data_models /app/data_models
COPY --from=builder --chown=enjoystats:enjoystats /src/analytics /app/analytics
COPY --from=builder --chown=enjoystats:enjoystats /src/app /app/app
COPY --from=builder --chown=enjoystats:enjoystats /src/api /app/api
COPY .streamlit /app/.streamlit
COPY scripts/statman_web_entrypoint.sh /app/scripts/statman_web_entrypoint.sh
COPY scripts/statman_web_healthcheck.sh /app/scripts/statman_web_healthcheck.sh
COPY scripts/statman_web_watchdog.sh /app/scripts/statman_web_watchdog.sh
RUN chmod +x \
      /app/scripts/statman_web_entrypoint.sh \
      /app/scripts/statman_web_healthcheck.sh \
      /app/scripts/statman_web_watchdog.sh \
    && chown -R enjoystats:enjoystats /app/.streamlit /app/scripts

USER root

CMD ["/bin/sh", "/app/scripts/statman_web_entrypoint.sh"]
