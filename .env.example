DATABASE_URL=postgresql+asyncpg://enjoystats:enjoystats@localhost:5432/enjoystats
ENJOYSTATS_DEBUG=false
ENJOYSTATS_HOST=0.0.0.0
ENJOYSTATS_PORT=8000
ENJOYSTATS_API_URL=http://127.0.0.1:8000
POSTGRES_USER=enjoystats
POSTGRES_PASSWORD=enjoystats
POSTGRES_DB=enjoystats

# StatMan (Grok Bot) — preferred external tag source. Webhook is optional.
STATMAN_BOT_URL=https://x.ai/bot/Nzfsi4AUBHfUB0tsb0aCx
# STATMAN_WEBHOOK_URL=
# STATMAN_WEBHOOK_KEY=

# STAT MAN TypeScript app
# DATABASE_URL=file:./statman.sqlite

# --- Railway / Docker shared volume (web + worker) ---
# Mount the same volume at /data on both services.
ENJOYSTATS_JOBS_DIR=/data/jobs
ENJOYSTATS_FILM_INBOX=/data/inbox
ENJOYSTATS_FILM_UPLOADS=/data/uploads
# Web: enqueue only — Worker runs Analyse
STATMAN_USE_EXTERNAL_WORKER=1
STATMAN_WORKER_POLL_S=3
# Web: slim upload API + same-origin portal (set by Dockerfile.dashboard)
STATMAN_UPLOAD_ONLY=1
ENJOYSTATS_SAME_ORIGIN_UPLOAD=1
# ENJOYSTATS_UVICORN_APP=api.upload_app:app
# Optional site password (Streamlit gate)
# STATMAN_SITE_PASSWORD=change-me

