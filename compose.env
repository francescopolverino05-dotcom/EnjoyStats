# Docker Compose defaults for the EnjoyStats stack.
# Copied into each service; hostnames resolve on the Compose network.

POSTGRES_USER=enjoystats
POSTGRES_PASSWORD=enjoystats
POSTGRES_DB=enjoystats
POSTGRES_HOST=db
POSTGRES_PORT=5432

# API talks to the db service, not localhost.
DATABASE_URL=postgresql://enjoystats:enjoystats@db:5432/enjoystats
ENJOYSTATS_HOST=0.0.0.0
ENJOYSTATS_PORT=8000
ENJOYSTATS_DEBUG=false

# Dashboard pulls live stats from the api service.
ENJOYSTATS_API_URL=http://api:8000
